{
    "providerId": "tinyhelm.com",
    "providerName": "TinyHelm",
    "serviceId": "hosting",
    "serviceName": "TinyHelm Hosting",
    "version": 1,
    "logoUrl": "https://tinyhelm.com/tinyhelm-transparent.png",
    "description": "Point your domain to a TinyHelm-managed server via an A record.",
    "variableDescription": "ip is the TinyHelm server IP. host is the subdomain relative to the zone (empty for apex).",
    "syncPubKeyDomain": "domainconnect.tinyhelm.com",
    "syncBlock": false,
    "records": [
        {
            "type": "A",
            "host": "%host%",
            "pointsTo": "%ip%",
            "ttl": 3600
        }
    ]
}
